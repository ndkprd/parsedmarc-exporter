# PostgreSQL (shared by parsedmarc and the exporter). Use your own password.
POSTGRES_USER=parsedmarc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=parsedmarc

# IMAP mailbox that receives DMARC reports
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SSL=True
IMAP_USER=dmarc@example.com
IMAP_PASSWORD=change-me

# Host port for the exporter (bound to 127.0.0.1)
EXPORTER_PORT=9190
