    {
      "id": 9,
      "type": "row",
      "title": "Senders",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 10,
          "type": "bargauge",
          "title": "SPF and DKIM alignment",
          "description": "Messages in the range by SPF/DKIM alignment result. Blue: both aligned. Orange: neither aligned (fails DMARC). Yellow: only one aligned, which still passes DMARC but is a single point of failure.",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROMETHEUS_DS}"
          },
          "gridPos": {
            "x": 0,
            "y": 21,
            "w": 8,
            "h": 7
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
              },
              "color": {
                "mode": "fixed",
                "fixedColor": "#F2C037"
              }
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "SPF true / DKIM true"
                },
                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "#2E6FDB"
                    }
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "SPF false / DKIM false"
                },
                "properties": [
                  {
                    "id": "color",
                    "value": {
                      "mode": "fixed",
                      "fixedColor": "#F2711C"
                    }
                  }
                ]
              }
            ]
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "showThresholdMarkers": true,
            "orientation": "horizontal",
            "displayMode": "gradient"
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "${PROMETHEUS_DS}"
              },
              "refId": "A",
              "expr": "sum by (spf_aligned, dkim_aligned) (increase(parsedmarc_aggregate_messages_total{job=\"$JOB\", domain=~\"$domain\"}[$__range]))",
              "legendFormat": "SPF {{spf_aligned}} / DKIM {{dkim_aligned}}",
              "editorMode": "code",
              "range": false,
              "instant": true,
              "format": "time_series"
            }
          ]
        },
        {
          "id": 11,
          "type": "bargauge",
          "title": "Messages by sender type",
          "description": "Messages in the range by the type parsedmarc assigns to the sending source (email provider, security gateway, ...). Unfamiliar types deserve a look at the top-sources table.",
          "datasource": {
            "type": "prometheus",
            "uid": "${PROMETHEUS_DS}"
          },
          "gridPos": {
            "x": 8,
            "y": 21,
            "w": 8,
            "h": 7
          },
          "fieldConfig": {
