{
  "id": null,
  "uid": "parsedmarc-exporter-overview",
  "title": "parsedmarc — DMARC Overview",
  "description": "Are our domains passing DMARC, is anything being quarantined or rejected, and are reports still arriving? For email and security admins doing a weekly review or checking after an SPF/DKIM/DMARC change. Data comes from parsedmarc-exporter; counters change only when report batches are stored, so trends use daily windows. Colours: blue = good/neutral, yellow = warning, orange = bad.",
  "tags": [
    "parsedmarc",
    "dmarc",
    "prometheus"
  ],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "schemaVersion": 39,
  "version": 1,
  "links": [
    {
      "title": "parsedmarc-exporter",
      "type": "link",
      "url": "https://gitlab.com/endekasoft/parsedmarc-exporter",
      "icon": "external link",
      "targetBlank": true,
      "keepTime": false,
      "includeVars": false,
      "asDropdown": false,
      "tags": [],
      "tooltip": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "PROMETHEUS_DS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "JOB",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${PROMETHEUS_DS}"
        },
        "query": "label_values(parsedmarc_exporter_up, job)",
        "definition": "label_values(parsedmarc_exporter_up, job)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "regex": "",
        "options": [],
        "skipUrlSync": false,
        "current": {
          "selected": true,
          "text": "parsedmarc",
          "value": "parsedmarc"
        }
      },
      {
        "name": "domain",
        "label": "Domain",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${PROMETHEUS_DS}"
        },
        "query": "label_values(parsedmarc_aggregate_messages_total{job=\"$JOB\"}, domain)",
        "definition": "label_values(parsedmarc_aggregate_messages_total{job=\"$JOB\"}, domain)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "regex": "",
        "options": [],
        "skipUrlSync": false,
        "current": {},
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "DMARC pass rate",
      "description": "Share of messages in stored aggregate reports that passed DMARC over the selected range. Blue at 98% or above, yellow below 98%, orange below 90%. If it drops, open the Senders row to see which source fails.",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROMETHEUS_DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F2711C",
                "value": null
              },
              {
                "color": "#F2C037",
                "value": 0.9
              },
              {
                "color": "#2E6FDB",
                "value": 0.98
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "noValue": "n/a"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${PROMETHEUS_DS}"
          },
          "refId": "A",
          "expr": "sum(increase(parsedmarc_aggregate_messages_total{job=\"$JOB\", domain=~\"$domain\", dmarc_passed=\"true\"}[$__range])) / sum(increase(parsedmarc_aggregate_messages_total{job=\"$JOB\", domain=~\"$domain\"}[$__range]))",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Messages reported",
      "description": "Messages covered by the aggregate reports stored in the selected range (when parsedmarc stored them, not when the mail was sent).",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROMETHEUS_DS}"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${PROMETHEUS_DS}"
          },
          "refId": "A",
          "expr": "sum(increase(parsedmarc_aggregate_messages_total{job=\"$JOB\", domain=~\"$domain\"}[$__range]))",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Quarantined or rejected",
      "description": "Share of messages the receiving servers quarantined or rejected under your DMARC policy. Blue at 0, yellow above 0, orange above 1%. Check the disposition trend and the sender breakdown before tightening or relaxing the policy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROMETHEUS_DS}"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2E6FDB",
                "value": null
              },
              {
                "color": "#F2C037",
                "value": 1e-07
              },
              {
                "color": "#F2711C",
                "value": 0.01
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${PROMETHEUS_DS}"
          },
          "refId": "A",
          "expr": "(sum(increase(parsedmarc_aggregate_messages_total{job=\"$JOB\", domain=~\"$domain\", disposition=~\"quarantine|reject\"}[$__range])) or vector(0)) / sum(increase(parsedmarc_aggregate_messages_total{job=\"$JOB\", domain=~\"$domain\"}[$__range]))",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Stalest domain: hours since last report",
      "description": "Age of the newest aggregate report of the domain that has been silent the longest. Reports usually lag 1-2 days: blue under 48h, yellow under 72h, orange beyond. Orange means a sender stopped reporting or ingestion is stuck.",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROMETHEUS_DS}"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2E6FDB",
                "value": null
              },
              {
                "color": "#F2C037",
                "value": 48
              },
              {
                "color": "#F2711C",
                "value": 72
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "noValue": "n/a"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${PROMETHEUS_DS}"
          },
          "refId": "A",
          "expr": "(time() - min(parsedmarc_last_report_end_timestamp_seconds{job=\"$JOB\", domain=~\"$domain\", report_type=\"aggregate\"})) / 3600",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Exporter",
      "description": "1 if the exporter reached PostgreSQL on its last scrape. Orange means the numbers on this dashboard may be stale; see the Exporter health row.",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROMETHEUS_DS}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F2711C",
                "value": null
              },
              {
                "color": "#2E6FDB",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "n/a",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down"
                },
                "1": {
                  "text": "Up"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${PROMETHEUS_DS}"
          },
          "refId": "A",
          "expr": "min(parsedmarc_exporter_up{job=\"$JOB\"})",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Messages per day: pass vs fail",
      "description": "Messages stored per day, split by DMARC result (rolling 1d window, because reports arrive in daily batches). Orange growth means more unauthenticated mail claiming your domain.",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROMETHEUS_DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisLabel": "",
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pass"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2E6FDB"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fail"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2711C"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${PROMETHEUS_DS}"
          },
          "refId": "A",
          "expr": "sum(increase(parsedmarc_aggregate_messages_total{job=\"$JOB\", domain=~\"$domain\", dmarc_passed=\"true\"}[1d]))",
          "legendFormat": "Pass",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${PROMETHEUS_DS}"
          },
          "refId": "B",
          "expr": "sum(increase(parsedmarc_aggregate_messages_total{job=\"$JOB\", domain=~\"$domain\", dmarc_passed=\"false\"}[1d]))",
          "legendFormat": "Fail",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "DMARC pass rate by domain",
      "description": "Daily DMARC pass rate per domain (rolling 1d). The line turns yellow below 98% and orange below 90%; dashed lines mark the same thresholds as the stat tile.",
      "datasource": {
        "type": "prometheus",
        "uid": "${PROMETHEUS_DS}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F2711C",
                "value": null
              },
              {
                "color": "#F2C037",
                "value": 0.9
              },
              {
                "color": "#2E6FDB",
                "value": 0.98
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisLabel": "",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${PROMETHEUS_DS}"
          },
          "refId": "A",
          "expr": "sum by (domain) (increase(parsedmarc_aggregate_messages_total{job=\"$JOB\", domain=~\"$domain\", dmarc_passed=\"true\"}[1d])) / sum by (domain) (increase(parsedmarc_aggregate_messages_total{job=\"$JOB\", domain=~\"$domain\"}[1d]))",
          "legendFormat": "{{domain}}",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
